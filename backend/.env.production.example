# Example only: set these values in the BACKEND Vercel project's Environment Variables.
# Spring Boot does not load this file automatically. Never commit a real .env.production.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Copy the pooler host and username from Supabase Connect. Use a NEW database/project.
# Runtime: Transaction pooler (6543); migrations: Session pooler (5432).
SPRING_DATASOURCE_URL=jdbc:postgresql://POOLER_HOST:6543/postgres?sslmode=require&prepareThreshold=0&currentSchema=training_app
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_FLYWAY_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require&currentSchema=training_app
SPRING_FLYWAY_USER=postgres.PROJECT_REF
SPRING_FLYWAY_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

APP_JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_FRONTEND_URL=https://FRONTEND_PROJECT.vercel.app

# SMTP delivers account emails. The technical log transport writes private
# [MAIL LINK] entries instead and does not send email.
APP_MAIL_MODE=smtp
APP_MAIL_FROM=no-reply@YOUR_VERIFIED_DOMAIN.example

# Optional ADDITIONAL exact frontend origins, separated by commas. APP_FRONTEND_URL is always allowed.
APP_CORS_ALLOWED_ORIGINS=

# Required only for APP_MAIL_MODE=smtp. Example using port 587 with mandatory STARTTLS.
SPRING_MAIL_HOST=SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
SPRING_MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_SSL_ENABLE=false
