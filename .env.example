# Docker opens links at this frontend origin. Local Vite uses http://localhost:5173.
# Local-only account: dev@example.test / devdevdev. Use docker without dev outside local testing.
SPRING_PROFILES_ACTIVE=docker,dev
APP_FRONTEND_URL=http://localhost:3000
APP_MAIL_FROM=no-reply@aplikacja.local
APP_ACCOUNT_EMAIL_CONFIRMATION_TTL=24h
APP_ACCOUNT_PASSWORD_RESET_TTL=30m
APP_ACCOUNT_ACCOUNT_DELETION_TTL=30m

# Replace before deploying outside the local development environment (at least 32 bytes).
APP_JWT_SECRET=dev-jwt-secret-min-32-znakow-dla-hs256-aplikacja-trenerska

# Docker Mailpit; for a real SMTP provider configure credentials and TLS below.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
