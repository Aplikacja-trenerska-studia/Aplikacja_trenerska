# Local Vite and Docker use the existing /api proxy when this is blank.
VITE_API_URL=

# Vercel frontend project: set this in Environment Variables before building.
# This is a public backend origin, never a secret or Supabase database URL.
# VITE_API_URL=https://your-backend.vercel.app

# Optional student demo: match backend APP_MAIL_MODE=log. No real emails are sent.
# Omit or use smtp for real delivery. Changing this requires rebuilding the frontend.
VITE_MAIL_MODE=smtp
